{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "duvcollections",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duvcollections",
      "database_id": "3707b26b-20c6-42d2-a45a-2314b081a875"
    }
  ],
  "observability": {
    "enabled": true
  }
}
