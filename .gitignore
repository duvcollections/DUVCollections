# --- Secrets. Never commit these. ------------------------------------------
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key
secrets.json

# --- Dependencies ----------------------------------------------------------
/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# --- Build output ----------------------------------------------------------
/.next/
/out/
/build
/dist
.open-next/
.wrangler/
.vercel

# --- Generated types -------------------------------------------------------
next-env.d.ts
cloudflare-env.d.ts
*.tsbuildinfo

# --- Archives (commit the extracted files, not the zip) --------------------
*.zip

# --- Logs & caches ---------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
.turbo/
/coverage

# --- Testing / analytics ---------------------------------------------------
/test-results/
/playwright-report/

# --- OS & editor -----------------------------------------------------------
.DS_Store
*.pem
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
